root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true

# Test inputs are compared byte for byte: leave them as they are.
[{test/**/fixtures/**,itest/fixtures/**,harness/samples/**}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset

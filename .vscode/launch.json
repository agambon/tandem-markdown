{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "Extension Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/itest/runTest.js",
      "outFiles": ["${workspaceFolder}/out/itest/**/*.js"],
      "preLaunchTask": "build: itest",
      "console": "integratedTerminal"
    }
  ]
}
